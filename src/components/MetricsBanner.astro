---
import { getCollection } from 'astro:content';
const publications = await getCollection('publications');
const projects = await getCollection('projects');
const grants = await getCollection('grants');
const metrics = [
  { value: publications.filter((p) => p.data.type !== 'patent').length, label: 'papers' },
  { value: projects.length, label: 'software repositories' },
  { value: '19', label: 'MSc students supervised in total' },
  { value: grants.length, label: 'funded projects' },
  { value: publications.filter((p) => p.data.type === 'patent').length, label: 'patent' },
];
---

<dl class="mt-7 flex flex-wrap gap-2.5">
  {metrics.map((item) => (
    <div class="rounded-lg border border-stone-200 dark:border-stone-800 bg-white/70 dark:bg-stone-900/60 px-3 py-2.5 w-[8.5rem]">
      <dt class="text-xl font-semibold text-stone-900 dark:text-stone-100">{item.value}</dt>
      <dd class="mt-0.5 text-[0.7rem] uppercase tracking-wide leading-tight text-stone-500 dark:text-stone-400">{item.label}</dd>
    </div>
  ))}
</dl>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PublicationYearGroup from '../components/PublicationYearGroup.astro';
import ProjectGroup from '../components/ProjectGroup.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { researchDirections } from '../data/research';
import { bioTimeline, courses, supervisionHighlights } from '../data/profile';

const withBase = (path: string) => {
  const base = import.meta.env.BASE_URL;
  const rest = path.startsWith('/') ? path.slice(1) : path;
  return `${base}${base.endsWith('/') ? '' : '/'}${rest}`;
};

const allPubs = await getCollection('publications');
const patents = allPubs.filter((p) => p.data.type === 'patent');
const publications = allPubs.filter((p) => p.data.type !== 'patent').sort((a, b) => {
  if (b.data.year !== a.data.year) return b.data.year - a.data.year;
  return a.data.title.localeCompare(b.data.title);
});
const groupPublicationsByYear = (items: typeof publications) => {
  const grouped = items.reduce<Record<number, typeof publications>>((acc, p) => {
    (acc[p.data.year] ||= []).push(p);
    return acc;
  }, {});
  return Object.keys(grouped)
    .map(Number)
    .sort((a, b) => b - a)
    .map((year) => ({ year, items: grouped[year] }));
};
const previewPublications = publications.filter((p) => p.data.featured);
const previewPublicationGroups = groupPublicationsByYear(previewPublications);
const publicationGroups = groupPublicationsByYear(publications);

const allProjects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
const grants = (await getCollection('grants')).sort(
  (a, b) => a.data.order - b.data.order,
);

---

<BaseLayout>
  {/* ---------- About ---------- */}
  <section id="about" class="bg-stone-50 dark:bg-stone-950">
    <div class="container-wide py-12 md:py-16">
      <div class="flex flex-col md:flex-row md:items-start gap-6 md:gap-10">
        <img
          src={withBase('/images/halfbody.webp')}
          alt="Portrait of Xiang Ma"
          width="700"
          height="1199"
          class="w-40 sm:w-48 md:w-56 lg:w-64 h-auto shrink-0 self-center rounded-lg border border-stone-200 dark:border-stone-800 shadow-sm"
        />
        <div class="min-w-0 flex-1">
          <div class="text-xs uppercase tracking-widest text-accent dark:text-accent-d mb-3">
            Lecturer · China Jiliang University
          </div>
          <h1 class="text-3xl md:text-4xl font-semibold leading-tight">Xiang Ma</h1>

          <p class="mt-5 max-w-4xl leading-relaxed text-[0.98rem] sm:text-base text-stone-800 dark:text-stone-200">
            I am a lecturer in Computer Science at China Jiliang University.
            My research focuses on <strong>optical measurement and image analysis</strong>,
            particularly ophthalmic lens inspection and OCT metrology. My related work
            includes eye tracking, gaze estimation, and machine learning for environmental
            and engineering systems.
          </p>

          <div class="mt-7">
            <div class="text-xs uppercase tracking-widest text-stone-500 dark:text-stone-400 mb-2">Bio</div>
            <ol class="space-y-2">
              {bioTimeline.filter((item) => !('showOnHomepage' in item) || item.showOnHomepage).map((item) => (
                <li class="grid grid-cols-[5.5rem_1fr] gap-3 text-sm text-stone-800 dark:text-stone-200">
                  <span class="font-mono text-xs text-stone-500 dark:text-stone-400 pt-0.5">{item.period}</span>
                  <span>{item.text}</span>
                </li>
              ))}
            </ol>
          </div>

          <div id="contact" class="mt-7 text-sm text-stone-600 dark:text-stone-400 flex flex-wrap gap-x-6 gap-y-2">
            <span><span class="text-stone-400 dark:text-stone-500">Email · </span><a href="mailto:brant.mar@gmail.com">brant.mar@gmail.com</a></span>
            <span><span class="text-stone-400 dark:text-stone-500">Alt · </span><a href="mailto:maxiang@cjlu.edu.cn">maxiang@cjlu.edu.cn</a></span>
            <span><a href={withBase('/cv/')}>Curriculum vitae</a></span>
            <span><span class="text-stone-400 dark:text-stone-500">GitHub · </span><a href="https://github.com/BMProjects">BMProjects</a></span>
            <span><span class="text-stone-400 dark:text-stone-500">LinkedIn · </span><a href="https://www.linkedin.com/in/xiang-ma-05ab2b318">xiang-ma</a></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ---------- Research + Projects (merged) ---------- */}
  <section id="research" class="bg-sky-50/60 dark:bg-sky-950/20 border-y border-sky-100 dark:border-sky-950/40">
    <div class="container-wide py-12 md:py-16">
      <SectionHeading kicker="Research" title="Research and Software" />
      {researchDirections.filter((area) => area.primary).map((area) => (
        <ProjectGroup
          title={area.title}
          summary={area.summary}
          projects={allProjects.filter((project) => project.data.area === area.key)}
        />
      ))}
      <details id="other-software" class="mt-8 border-t border-sky-200 dark:border-sky-900 pt-5">
        <summary class="cursor-pointer text-sm font-medium text-accent dark:text-accent-d py-2">LLM applications (4 projects)</summary>
        <div class="mt-6">
          {researchDirections.filter((area) => !area.primary).map((area) => (
            <ProjectGroup title={area.title} summary={area.summary} projects={allProjects.filter((project) => project.data.area === area.key)} />
          ))}
          <p class="text-sm text-stone-600 dark:text-stone-400 leading-relaxed">A related industry-facing project, Fashion Similarity Detection Tool, supports clothing detection and visual similarity retrieval from e-commerce screenshots.</p>
        </div>
      </details>
    </div>
  </section>

  {/* ---------- Publications ---------- */}
  <section id="publications" class="bg-stone-50 dark:bg-stone-950">
    <div class="container-wide py-12 md:py-16">
      <SectionHeading kicker="Selected" title="Publications" />
      <div id="publication-preview">
        {previewPublicationGroups.map((group, index) => (
          <PublicationYearGroup year={group.year} items={group.items} first={index === 0} showRole />
        ))}
      </div>
      <p class="text-xs text-stone-500 dark:text-stone-400 mt-4">* Corresponding author. Xiang Ma is shown in bold.</p>
      <details id="all-publications" class="mt-6 border-t border-stone-200 dark:border-stone-800 pt-4">
        <summary class="cursor-pointer text-sm font-medium text-accent dark:text-accent-d py-2">All publications ({publications.length} papers)</summary>
        <div class="mt-6">
          {publicationGroups.map((group, index) => (
            <PublicationYearGroup year={group.year} items={group.items} first={index === 0} />
          ))}
        </div>
      </details>
      {patents.length > 0 && <section class="mt-8 pt-6 border-t border-stone-200 dark:border-stone-800">
        <h3 class="text-lg font-semibold mb-4">Patent</h3>
        <ol>{patents.map(({ data }) => <PublicationItem {...data} showYear />)}</ol>
      </section>}
    </div>
  </section>

  {/* ---------- Teaching ---------- */}
  <section id="teaching" class="bg-amber-50/60 dark:bg-amber-950/15 border-y border-amber-100 dark:border-amber-950/40">
    <div class="container-wide py-12 md:py-16">
      <SectionHeading kicker="Courses & Supervision" title="Teaching" />
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-6 divide-y md:divide-y-0 divide-amber-200/60 dark:divide-amber-900/40">
        {courses.map((c) => (
          <li class="py-3 text-stone-800 dark:text-stone-200 border-b border-amber-200/60 dark:border-amber-900/40">
            <div class="flex flex-wrap justify-between gap-x-4 gap-y-1">
              <span class="font-medium">{c.name}</span>
              <span class="text-sm text-stone-500 dark:text-stone-400 shrink-0">{c.years}</span>
            </div>
            <p class="text-sm text-stone-600 dark:text-stone-400 mt-1">{c.features}</p>
          </li>
        ))}
      </ul>
      <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4 text-sm text-stone-700 dark:text-stone-300">
        {supervisionHighlights.map((item) => (
          <div class="border-t border-amber-300 dark:border-amber-800 pt-3">{item}</div>
        ))}
      </div>
    </div>
  </section>

  {/* ---------- Grants ---------- */}
  <section id="grants" class="bg-emerald-50/60 dark:bg-emerald-950/15">
    <div class="container-wide py-12 md:py-16">
      <SectionHeading kicker="Funding" title="Research Grants" />
      <ul class="grid grid-cols-1 lg:grid-cols-2 gap-x-8 gap-y-5">
        {grants.map((g) => (
          <li>
            <div class="text-stone-900 dark:text-stone-100">{g.data.title}</div>
            <div class="text-sm text-stone-500 dark:text-stone-400 mt-0.5">
              {g.data.funder} · {g.data.start} – {g.data.end}
              {g.data.status && <> · {g.data.status}</>}
            </div>
            <p class="text-sm text-stone-700 dark:text-stone-300 mt-1">Role: {g.data.role}</p>
            {g.data.description && (
              <p class="text-sm text-stone-700 dark:text-stone-300 mt-1.5">{g.data.description}</p>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<script>
  const revealHashTarget = () => {
    let id: string;
    try { id = decodeURIComponent(location.hash.slice(1)); } catch { return; }
    const target = document.getElementById(id);
    if (!target) return;
    let ancestor: HTMLElement | null = target;
    while (ancestor) {
      if (ancestor instanceof HTMLDetailsElement) ancestor.open = true;
      ancestor = ancestor.parentElement;
    }
    requestAnimationFrame(() => target.scrollIntoView({ block: 'start' }));
  };
  window.addEventListener('hashchange', revealHashTarget);
  revealHashTarget();
</script>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectGroup from '../components/ProjectGroup.astro';
import { researchDirections } from '../data/research';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Projects — Xiang Ma">
  <section class="bg-sky-50/60 dark:bg-sky-950/20">
    <div class="container-wide py-14 md:py-20">
      <h1 class="text-3xl md:text-4xl font-semibold">Projects</h1>
      <p class="text-stone-600 dark:text-stone-400 mt-3 mb-10 max-w-2xl leading-relaxed">Research and software projects, organised by topic. Optical and imaging metrology is my current focus.</p>
      {researchDirections.map((area) => <ProjectGroup title={area.title} summary={area.summary} projects={projects.filter((project) => project.data.area === area.key)} />)}
    </div>
  </section>
</BaseLayout>
